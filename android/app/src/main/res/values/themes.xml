<?xml version="1.0" encoding="utf-8"?>
<!--
    Base XML theme: required by the system for the splash/launch window before Compose takes over.
    Real theming is done in Compose via EngineerCompanionTheme (ui/theme/Theme.kt).
    We use Theme.Material3.DayNight.NoActionBar as the parent so the status-bar / nav-bar colours
    match the dark background on launch without a white flash.
-->
<resources>
    <style name="Theme.EngineerCompanion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:statusBarColor">#0A0A0A</item>
        <item name="android:navigationBarColor">#0A0A0A</item>
    </style>
</resources>
